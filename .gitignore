# Whisper model binaries downloaded locally for dev
artifacts/models/

# Benchmark sample audio downloaded locally for dev
artifacts/samples/

# Argos Python venv + translation model packages downloaded locally for dev
artifacts/argos/

# Spike raw audio (local input WAVs; JSON/CSV/log evidence is committed, audio is not)
artifacts/spike-corpus/*.wav
artifacts/spike-compare/*.wav

# Ad-hoc spike/validation outputs (re-runnable, not permanent evidence)
artifacts/spike-result-*/
artifacts/validation/

# Ad-hoc Gemini-stop reproduction harness (untracked; runs locally with
# the user's GEMINI_API_KEY in their shell — the script never holds the key).
artifacts/spike-corpus/run_gemini_stop_probe.cmd
artifacts/spike-corpus/.gemini_key
artifacts/spike-corpus/*.key.txt

# Real-world acceptance runtime diagnostic dumps (PASS evidence lives in *parity_acceptance*.log)
*_app_stderr.log

# Scratch UIA probe scripts
probe-*.ps1

