<Window x:Class="UniversalCaptions.App.Overlay.CaptionOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Captions"
        Width="560"
        MinWidth="280"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI">
    <Window.Resources>
        <!-- Borderless transparent icon-button used in the header -->
        <Style x:Key="ChromeIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#99FFFFFF" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#33FFFFFF" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Transparent pill-button used for the bottom chevron -->
        <Style x:Key="ChevronButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#66FFFFFF" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="4" Padding="16,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#22FFFFFF" />
                                <Setter Property="Foreground" Value="#AAFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Chrome: dark semi-transparent card matching Google Chrome's Live Caption palette -->
    <Border x:Name="OverlayChrome"
            Background="#D9202124"
            BorderBrush="#1AFFFFFF"
            BorderThickness="1"
            CornerRadius="8"
            ClipToBounds="True"
            MouseLeftButtonDown="OnChromeMouseLeftButtonDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ─── Row 0: Header ─── -->
            <Grid Grid.Row="0" Margin="14,10,10,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: microphone icon + "Live Caption" label + language pills -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <!-- Accessibility / microphone glyph -->
                    <TextBlock Text="&#xF136;"
                               FontFamily="Segoe MDL2 Assets"
                               Foreground="#88FFFFFF"
                               FontSize="13"
                               VerticalAlignment="Center"
                               Margin="0,0,7,0" />

                    <TextBlock Text="Live Caption"
                               Foreground="White"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />

                    <!-- Translation language pills: "EN  →  TL" (hidden when translation is off) -->
                    <StackPanel x:Name="TranslationBadgePanel"
                                Orientation="Horizontal"
                                Visibility="Collapsed"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center">
                        <Border Background="#2DFFFFFF" CornerRadius="10" Padding="8,2">
                            <TextBlock x:Name="SourceLanguageBadge"
                                       Foreground="White"
                                       FontSize="11"
                                       FontWeight="SemiBold" />
                        </Border>
                        <TextBlock Text="→"
                                   Foreground="#77FFFFFF"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="5,0" />
                        <Border Background="#2DFFFFFF" CornerRadius="10" Padding="8,2">
                            <TextBlock x:Name="TargetLanguageBadge"
                                       Foreground="White"
                                       FontSize="11"
                                       FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Right: close button -->
                <Button x:Name="CloseButton"
                        Grid.Column="1"
                        Style="{StaticResource ChromeIconButton}"
                        ToolTip="Hide captions"
                        Click="OnCloseClicked">
                    <TextBlock Text="&#xE711;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="11" />
                </Button>
            </Grid>

            <!-- ─── Row 1: Caption text area ─── -->
            <!--
                Single ScrollViewer+TextBlock renders all captions as a continuous flowing paragraph.
                Auto-scrolls to the bottom on every render so the newest line is always visible.
                MaxHeight is set in code-behind via ApplyExpandedState().
            -->
            <ScrollViewer x:Name="CaptionScroller"
                          Grid.Row="1"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled"
                          ClipToBounds="True"
                          Height="160"
                          Margin="16,4,16,4"
                          Padding="0,4,0,4"
                          Focusable="False">
                <ScrollViewer.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0.0" />
                        <GradientStop Color="#FF000000" Offset="0.12" />
                        <GradientStop Color="#FF000000" Offset="1.0" />
                    </LinearGradientBrush>
                </ScrollViewer.OpacityMask>
                <Grid>
                    <TextBlock x:Name="CaptionTextBlock"
                               TextWrapping="Wrap"
                               Foreground="White"
                               FontSize="20"
                               LineHeight="28"
                               Margin="0,0,4,0"
                               Visibility="Collapsed" />
                    <TextBlock x:Name="HintText"
                               Text="Listening…"
                               Foreground="#77FFFFFF"
                               FontStyle="Italic"
                               FontSize="14"
                               Visibility="Collapsed" />
                </Grid>
            </ScrollViewer>

            <!-- ─── Row 2: Collapse / expand chevron ─── -->
            <Button x:Name="CollapseButton"
                    Grid.Row="2"
                    Style="{StaticResource ChevronButton}"
                    HorizontalAlignment="Center"
                    Height="20"
                    Margin="0,0,0,6"
                    ToolTip="Collapse"
                    Click="OnCollapseToggled">
                <TextBlock x:Name="CollapseChevron"
                           Text="&#xE70E;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="11"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Button>
        </Grid>
    </Border>
</Window>
