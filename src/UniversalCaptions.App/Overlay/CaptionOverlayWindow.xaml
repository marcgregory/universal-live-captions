<Window x:Class="UniversalCaptions.App.Overlay.CaptionOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="Captions"
        Width="720"
        Height="180"
        MinWidth="200"
        MinHeight="72"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        SnapsToDevicePixels="True">
    <Border x:Name="OverlayChrome"
            Background="#D8101010"
            BorderBrush="#59000000"
            BorderThickness="1"
            CornerRadius="8"
            MouseLeftButtonDown="OnChromeMouseLeftButtonDown">
        <Grid>
            <Grid x:Name="OverlayRoot" Margin="16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ItemsControl x:Name="HistoryList" Grid.Row="0" Margin="0,0,0,6">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Text}"
                                   TextWrapping="Wrap"
                                   Opacity="0.72" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Grid.Row="1">
                <TextBlock x:Name="ActiveCaption"
                           TextWrapping="Wrap"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="HintText"
                           Text="Start captions to see them here."
                           Opacity="0.5" />
            </StackPanel>
            </Grid>

            <primitives:Thumb x:Name="ResizeGrip"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Bottom"
                              Width="16"
                              Height="16"
                              Cursor="SizeNWSE"
                              DragStarted="OnResizeGripDragStarted"
                              DragDelta="OnResizeGripDragDelta"
                              DragCompleted="OnResizeGripDragCompleted">
                <Thumb.Template>
                    <ControlTemplate TargetType="primitives:Thumb">
                        <Path Data="M 16,0 L 16,16 L 0,16 Z"
                              Fill="#33333333"
                              Stroke="#66999999"
                              StrokeThickness="1" />
                    </ControlTemplate>
                </Thumb.Template>
            </primitives:Thumb>
        </Grid>
    </Border>
</Window>
