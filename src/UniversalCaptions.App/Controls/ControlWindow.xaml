<Window x:Class="UniversalCaptions.App.Controls.ControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Universal Live Captions"
        Width="400"
        Height="590"
        MinWidth="360"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">
    <Grid Margin="18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0"
                   Grid.ColumnSpan="2"
                   Text="Universal Live Captions"
                   FontSize="17"
                   FontWeight="SemiBold"
                   Margin="0,0,0,10" />

        <TextBlock Grid.Row="1"
                   Text="Audio source"
                   VerticalAlignment="Center" />
        <ComboBox x:Name="AudioSourceCombo"
                  Grid.Row="1"
                  Grid.Column="1"
                  Margin="10,4"
                  SelectionChanged="OnAudioSourceChanged" />

        <TextBlock Grid.Row="2"
                   Text="Language"
                   VerticalAlignment="Center" />
        <ComboBox x:Name="LanguageCombo"
                  Grid.Row="2"
                  Grid.Column="1"
                  Margin="10,4"
                  SelectionChanged="OnLanguageChanged" />

        <TextBlock Grid.Row="3"
                   Text="Translation"
                   VerticalAlignment="Center" />
        <CheckBox x:Name="TranslationToggle"
                  Grid.Row="3"
                  Grid.Column="1"
                  Margin="10,4"
                  Content="Translate to"
                  Checked="OnTranslationToggled"
                  Unchecked="OnTranslationToggled" />

        <TextBlock Grid.Row="4"
                   Text="Target language"
                   VerticalAlignment="Center" />
        <ComboBox x:Name="TargetLanguageCombo"
                  Grid.Row="4"
                  Grid.Column="1"
                  Margin="10,4"
                  IsEnabled="False"
                  SelectionChanged="OnTargetLanguageChanged" />

        <TextBlock Grid.Row="5"
                   Text="Translation provider"
                   VerticalAlignment="Center" />
        <ComboBox x:Name="ProviderCombo"
                  Grid.Row="5"
                  Grid.Column="1"
                  Margin="10,4"
                  SelectionChanged="OnProviderChanged">
            <ComboBox.ItemContainerStyle>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
                </Style>
            </ComboBox.ItemContainerStyle>
        </ComboBox>

        <TextBlock Grid.Row="6"
                   Text="Gemini API key"
                   VerticalAlignment="Top"
                   Margin="0,8,0,0" />
        <StackPanel x:Name="GeminiKeyPanel"
                    Grid.Row="6"
                    Grid.Column="1"
                    Margin="10,4">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="GeminiKeyStatusText"
                           Text="Not configured"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="GeminiKeyLastUpdatedText"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="#888888"
                           Text="" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Button x:Name="AddGeminiKeyButton"
                        Content="Add API key…"
                        Padding="10,4"
                        Margin="0,0,8,0"
                        Click="OnAddGeminiKeyClicked" />
                <Button x:Name="UpdateGeminiKeyButton"
                        Content="Update…"
                        Padding="10,4"
                        Margin="0,0,8,0"
                        Click="OnUpdateGeminiKeyClicked" />
                <Button x:Name="RemoveGeminiKeyButton"
                        Content="Remove"
                        Padding="10,4"
                        Click="OnRemoveGeminiKeyClicked" />
            </StackPanel>
            <TextBlock Margin="0,6,0,0" VerticalAlignment="Center">
                <Hyperlink x:Name="GetGeminiKeyLink"
                           NavigateUri="https://aistudio.google.com/app/apikey"
                           RequestNavigate="OnGetGeminiKeyLinkRequestNavigate">
                    <Run Text="Get your API key from Google AI Studio" />
                    <Run Text=" ↗" />
                </Hyperlink>
            </TextBlock>
        </StackPanel>

        <StackPanel Grid.Row="7"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    Margin="0,8,0,0">
            <TextBlock x:Name="CaptureIndicator"
                       Text="●"
                       FontSize="13"
                       Foreground="#888888"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="StatusText"
                       Margin="8,0,0,0"
                       Text="Ready"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center" />
        </StackPanel>

        <TextBlock Grid.Row="8"
                   Grid.Column="0"
                   Text="STT latency"
                   VerticalAlignment="Center" />
        <TextBlock x:Name="LatencyText"
                   Grid.Row="8"
                   Grid.Column="1"
                   Margin="10,2"
                   Text="—"
                   VerticalAlignment="Center" />

        <TextBlock Grid.Row="9"
                   Grid.Column="0"
                   Text="E2E latency"
                   VerticalAlignment="Center" />
        <TextBlock x:Name="EndToEndLatencyText"
                   Grid.Row="9"
                   Grid.Column="1"
                   Margin="10,2"
                   Text="—"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center" />

        <TextBlock Grid.Row="10"
                   Grid.Column="0"
                   Text="Overlay opacity"
                   VerticalAlignment="Center" />
        <Slider x:Name="OpacitySlider"
                Grid.Row="10"
                Grid.Column="1"
                Margin="10,4"
                Minimum="0.2"
                Maximum="1"
                Value="1"
                ValueChanged="OnOpacityChanged" />

        <TextBlock Grid.Row="11"
                   Grid.Column="0"
                   Text="Overlay font"
                   VerticalAlignment="Center" />
        <Slider x:Name="FontSizeSlider"
                Grid.Row="11"
                Grid.Column="1"
                Margin="10,4"
                Minimum="10"
                Maximum="96"
                Value="16"
                ValueChanged="OnFontSizeChanged" />

        <TextBlock Grid.Row="12"
                   Text="Click-through"
                   VerticalAlignment="Center" />
        <CheckBox x:Name="ClickThroughToggle"
                  Grid.Row="12"
                  Grid.Column="1"
                  Margin="10,4"
                  Content="Let clicks pass to other apps"
                  Checked="OnClickThroughToggled"
                  Unchecked="OnClickThroughToggled" />

        <StackPanel Grid.Row="13"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom">
            <Button x:Name="ShowCaptionsButton"
                    Content="Show Captions"
                    Padding="14,6"
                    Margin="0,10,8,0"
                    Click="OnShowCaptionsClicked" />
            <Button x:Name="StartButton"
                    Content="Start Captions"
                    Padding="14,6"
                    Margin="0,10,8,0"
                    Click="OnStartClicked" />
            <Button x:Name="StopButton"
                    Content="Stop"
                    Padding="14,6"
                    Margin="0,10,0,0"
                    IsEnabled="False"
                    Click="OnStopClicked" />
        </StackPanel>
    </Grid>
</Window>